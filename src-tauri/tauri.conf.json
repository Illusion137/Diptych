{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Everett",
  "version": "0.1.0",
  "identifier": "com.sumi.eveett",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Everett",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": null,
      "entitlements": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMzM0MUFCRUUxRkFEOTIKUldTU3JSL3VxMEV6eWpOWEdjbDdmcURjTENwM21McUNuRktmZHh6MmxsV0xlc2g2dlBJeFdpWWcK",
      "endpoints": [
        "https://github.com/Illusion137/Everett/releases/latest/download/latest.json"
      ]
    }
  }
}